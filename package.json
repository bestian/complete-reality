{
  "name": "complete-reality",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "npm run copy-css && vite dev",
    "build": "npm run copy-css && npx tsx scripts/prerender.ts && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "prerender": "npm run copy-css && npx tsx scripts/prerender.ts",
    "copy-css": "npm run copy-semantic-css && npm run compile-scss",
    "copy-semantic-css": "cp node_modules/semantic-ui-css/semantic.min.css www/css/semantic.min.css",
    "compile-scss": "sass --no-source-map --style=expanded www/scss:www/css"
  },
  "keywords": [],
  "author": "",
  "description": "",
  "dependencies": {
    "@vue/server-renderer": "^3.5.32",
    "hono": "^4.12.25",
    "marked": "^18.0.2",
    "semantic-ui-css": "^2.5.0",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/compiler-sfc": "^3.5.32",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.103.0",
    "sass": "^1.93.2"
  }
}
